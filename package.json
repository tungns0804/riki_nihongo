{
  "name": "riki-nihongo",
  "version": "0.0.0",
  "description": "Riki Nihongo — khoá N3 JUNBI",
  "scripts": {
    "ng": "ng",
    "start": "npm run generate && ng serve",
    "build": "npm run generate && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "generate": "node scripts/generate-content.mjs",
    "generate:clean": "node scripts/generate-content.mjs --clean",
    "generate:check": "node scripts/generate-content.mjs --check",
    "verify": "npm run verify:content && npm run verify:i18n",
    "verify:content": "node scripts/generate-content.mjs --check",
    "verify:i18n": "node --experimental-strip-types --no-warnings scripts/verify-i18n.mjs"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.1.0",
    "@angular/compiler": "^20.1.0",
    "@angular/core": "^20.1.0",
    "@angular/forms": "^20.1.0",
    "@angular/platform-browser": "^20.1.0",
    "@angular/router": "^20.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.1.1",
    "@angular/cli": "^20.1.1",
    "@angular/compiler-cli": "^20.1.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.8.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.8.2"
  }
}
